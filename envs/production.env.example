# Never committed in clear text — see envs/README.md. This example documents
# every variable `envs/production.env` (or its SOPS-encrypted twin) must define.
COMPOSE_PROJECT_NAME=odoo-lab-production
ENVIRONMENT=production

NETWORK_PUBLIC=odoo-lab-production-public
NETWORK_PRIVATE=odoo-lab-production-private
NETWORK_DATABASE=odoo-lab-production-database
VOLUME_POSTGRES_DATA=odoo-lab-production-postgres-data
VOLUME_POSTGRES_WAL=odoo-lab-production-postgres-wal-archive
VOLUME_ODOO_FILESTORE=odoo-lab-production-odoo-filestore

# --- Images: pulled by exact digest from the registry, set by CI at deploy
# time (see .github/workflows/promote-production.yml) — do not hand-edit. ---
ODOO_IMAGE=ghcr.io/example-org/odoo-lab/odoo@sha256:REPLACED_BY_CI
POSTGRES_IMAGE=ghcr.io/example-org/odoo-lab/postgres@sha256:REPLACED_BY_CI
NGINX_IMAGE=ghcr.io/example-org/odoo-lab/nginx@sha256:REPLACED_BY_CI
PGBOUNCER_IMAGE=ghcr.io/example-org/odoo-lab/pgbouncer@sha256:REPLACED_BY_CI

POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=REPLACE_ME_ROTATE_EVERY_90_DAYS
ODOO_DB_USER=odoo_app
ODOO_DB_PASSWORD=REPLACE_ME_ROTATE_EVERY_90_DAYS
ODOO_DB_NAME=odoo
ODOO_ADMIN_PASSWD=REPLACE_ME_ROTATE_EVERY_90_DAYS
PGBOUNCER_AUTH_PASSWORD=REPLACE_ME_ROTATE_EVERY_90_DAYS
PG_EXPORTER_PASSWORD=REPLACE_ME_ROTATE_EVERY_90_DAYS

SERVER_NAME=odoo.example.com
HTTP_PORT=80
HTTPS_PORT=443
SSL_CERT_PATH=/etc/nginx/certs/live/odoo.example.com/fullchain.pem
SSL_KEY_PATH=/etc/nginx/certs/live/odoo.example.com/privkey.pem

# NOTE: ODOO_WORKERS / ODOO_LOG_LEVEL / ODOO_LIST_DB below are fallback
# defaults only — compose/docker-compose.production.yml sets these directly
# per-service and always wins. Kept here so a bare `docker compose up`
# without the production overlay still has sane values.
ODOO_WORKERS=4
ODOO_LOG_LEVEL=warn
ODOO_LIST_DB=False

SMTP_HOST=smtp.your-provider.example
SMTP_PORT=587
SMTP_USER=REPLACE_ME
SMTP_PASSWORD=REPLACE_ME
SMTP_TLS=True

GRAFANA_ADMIN_PASSWORD=REPLACE_ME_ROTATE_EVERY_90_DAYS

# --- Object storage for restic backups (see terraform/modules/object_storage) ---
RESTIC_REPOSITORY=s3:s3.eu-west-3.amazonaws.com/odoo-lab-production-backups-XXXXXX
RESTIC_PASSWORD=REPLACE_ME_STORE_IN_SECRET_MANAGER
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME
