# Copy to envs/dev.env and adjust. Safe defaults for a disposable local stack.
COMPOSE_PROJECT_NAME=odoo-lab-dev
ENVIRONMENT=dev

# --- Networking (must match `terraform output` after `make plan apply ENV=dev`) ---
NETWORK_PUBLIC=odoo-lab-dev-public
NETWORK_PRIVATE=odoo-lab-dev-private
NETWORK_DATABASE=odoo-lab-dev-database
VOLUME_POSTGRES_DATA=odoo-lab-dev-postgres-data
VOLUME_POSTGRES_WAL=odoo-lab-dev-postgres-wal-archive
VOLUME_ODOO_FILESTORE=odoo-lab-dev-odoo-filestore

# --- Images (built locally; see Makefile `build` target) ---
ODOO_IMAGE=odoo-lab/odoo:dev
POSTGRES_IMAGE=odoo-lab/postgres:dev
NGINX_IMAGE=odoo-lab/nginx:dev
PGBOUNCER_IMAGE=odoo-lab/pgbouncer:dev

# --- Odoo / DB credentials (dev-only, disposable) ---
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me-dev-only
ODOO_DB_USER=odoo_app
ODOO_DB_PASSWORD=change-me-dev-only
ODOO_DB_NAME=odoo
ODOO_ADMIN_PASSWD=change-me-dev-only
PGBOUNCER_AUTH_PASSWORD=change-me-dev-only
PG_EXPORTER_PASSWORD=change-me-dev-only

# --- Networking / TLS ---
SERVER_NAME=localhost
HTTP_PORT=80
HTTPS_PORT=443
SSL_CERT_PATH=/etc/nginx/certs/fullchain.pem
SSL_KEY_PATH=/etc/nginx/certs/privkey.pem

# --- Sizing ---
ODOO_WORKERS=0
ODOO_LOG_LEVEL=debug
ODOO_LIST_DB=True

# --- SMTP sandbox (see docker-compose.dev.yml `mailhog` service, profile "mail") ---
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=False

# --- Monitoring role password (see docker/postgres/init/03-*.sh) ---
GRAFANA_ADMIN_PASSWORD=change-me-dev-only
