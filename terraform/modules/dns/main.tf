# =============================================================================
# DNS records for one environment: the A record it serves on, plus the
# email-authentication trio (SPF/DKIM/DMARC) so outbound mail from Odoo
# (invoices, notifications) doesn't get marked as spam or spoofed.
#
# Disabled by default (see root variable `enable_cloud_dns`) — this module
# only runs `terraform apply` against Cloudflare when you explicitly opt in
# and provide `cloudflare_zone_id` / the CLOUDFLARE_API_TOKEN env var.
# =============================================================================

locals {
  subdomain = var.environment == "production" ? "odoo" : "${var.environment}-odoo"
  fqdn      = "${local.subdomain}.${var.domain_root}"
}

resource "cloudflare_record" "app" {
  zone_id = var.cloudflare_zone_id
  name    = local.subdomain
  type    = "A"
  content = var.server_ipv4
  ttl     = 300
  proxied = false # keep DNS-only so Nginx terminates TLS directly; flip to
                   # true if you want Cloudflare's proxy/WAF in front too.
}

resource "cloudflare_record" "spf" {
  zone_id = var.cloudflare_zone_id
  name    = local.subdomain
  type    = "TXT"
  content = "v=spf1 mx a:${local.fqdn} -all"
  ttl     = 3600
}

# DKIM public key is generated by the SMTP relay/provider (e.g. Amazon SES,
# Postmark, your own OpenDKIM) — paste its value into envs/*.env as
# SMTP_DKIM_PUBLIC_KEY and reference it here rather than hardcoding it.
resource "cloudflare_record" "dkim" {
  zone_id = var.cloudflare_zone_id
  name    = "default._domainkey.${local.subdomain}"
  type    = "TXT"
  content = "v=DKIM1; k=rsa; p=REPLACE_WITH_YOUR_DKIM_PUBLIC_KEY"
  ttl     = 3600
}

resource "cloudflare_record" "dmarc" {
  zone_id = var.cloudflare_zone_id
  name    = "_dmarc.${local.subdomain}"
  type    = "TXT"
  # Start at p=none (monitor only) and tighten to quarantine/reject once
  # aggregate reports (rua) confirm legitimate mail aligns — see
  # docs/runbooks/troubleshooting.md "Email deliverability" section.
  content = "v=DMARC1; p=none; rua=mailto:dmarc-reports@${var.domain_root}; fo=1"
  ttl     = 3600
}
